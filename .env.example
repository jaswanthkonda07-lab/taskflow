PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=

# Password-reset emails via Brevo HTTPS API (Render free tier blocks SMTP). Leave empty locally:
# the reset link is then printed in the server console instead.
BREVO_API_KEY=
MAIL_FROM=
# Public URL of your deployed site, used in reset links (e.g. https://taskflow-xxxx.onrender.com)
APP_URL=
